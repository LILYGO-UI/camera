# Debian application BSP for T-Display-K230. This file can also be used as
# a CMake initial-cache script (-C) with a previously published AppKit.
if(_LILYGO_K230_BSP_SELECTED)
    return()
endif()
function(_k230_bsp_complete root result)
    foreach(entry IN ITEMS usr/include/stdio.h usr/lib/riscv64-linux-gnu/crt1.o
            usr/lib/riscv64-linux-gnu/pkgconfig/libdrm.pc var/lib/dpkg/status
            usr/share/canaan-sdk/manifest.json)
        if(NOT EXISTS "${root}/${entry}")
            set(${result} FALSE PARENT_SCOPE)
            return()
        endif()
    endforeach()
    set(${result} TRUE PARENT_SCOPE)
endfunction()

function(_k230_bsp_ready root digest result)
    set(${result} FALSE PARENT_SCOPE)
    if(EXISTS "${root}/.k230-bsp.sha256")
        file(READ "${root}/.k230-bsp.sha256" saved LIMIT 65)
        string(STRIP "${saved}" saved)
        if(saved STREQUAL digest)
            _k230_bsp_complete("${root}" complete)
            set(${result} "${complete}" PARENT_SCOPE)
        endif()
    endif()
endfunction()

function(_k230_bsp_install directory asset url digest)
    set(root "${directory}/sysroot")
    _k230_bsp_ready("${root}" "${digest}" ready)
    if(ready)
        return()
    endif()
    file(MAKE_DIRECTORY "${directory}")
    file(LOCK "${directory}/install.lock" GUARD FUNCTION TIMEOUT 900)
    _k230_bsp_ready("${root}" "${digest}" ready)
    if(ready)
        return()
    endif()

    set(archive "${directory}/${asset}")
    set(actual "")
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
    endif()
    if(NOT actual STREQUAL digest)
        message(STATUS "Downloading K230 Debian BSP to ${archive}")
        file(DOWNLOAD "${url}" "${archive}.part" STATUS status TLS_VERIFY ON
            INACTIVITY_TIMEOUT 120 SHOW_PROGRESS)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${archive}.part")
            message(FATAL_ERROR "Could not download ${url}: ${status}")
        endif()
        file(SHA256 "${archive}.part" actual)
        if(NOT actual STREQUAL digest)
            file(REMOVE "${archive}.part")
            message(FATAL_ERROR "K230 BSP SHA-256 mismatch: expected ${digest}, got ${actual}")
        endif()
        file(RENAME "${archive}.part" "${archive}")
    endif()

    set(stage "${directory}/.extracting")
    file(REMOVE_RECURSE "${stage}")
    file(MAKE_DIRECTORY "${stage}")
    message(STATUS "Extracting K230 Debian BSP to ${root}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
    _k230_bsp_complete("${stage}/sysroot" complete)
    if(NOT complete)
        file(REMOVE_RECURSE "${stage}")
        message(FATAL_ERROR "K230 BSP is missing development files or Debian package metadata: ${archive}")
    endif()
    file(WRITE "${stage}/sysroot/.k230-bsp.sha256" "${digest}\n")
    # Only change the managed slot after the replacement is fully prepared.
    if(EXISTS "${root}" OR IS_SYMLINK "${root}")
        file(RENAME "${root}" "${stage}/previous")
    endif()
    file(RENAME "${stage}/sysroot" "${root}" RESULT published)
    if(NOT published STREQUAL "0")
        if(EXISTS "${stage}/previous" OR IS_SYMLINK "${stage}/previous")
            file(RENAME "${stage}/previous" "${root}")
        endif()
        message(FATAL_ERROR "Cannot install K230 BSP at ${root}: ${published}")
    endif()
    file(REMOVE_RECURSE "${stage}")
endfunction()

function(_k230_bsp_select)
    set(version "20261116T104343Z")
    set(asset "canaan-debian-t-display-k230-lilygo-ui-${version}.sysroot.tar.gz")
    set(url "https://github.com/LILYGO-UI/canaan-gen/releases/download/k230-debian-${version}/${asset}")
    set(digest "76f3c0000dbd8a0fa8b91b9a9c9700081ae9d2c83aca229bf7450f0e39f54ce1")
    # Leave the release defaults out of CMakeCache so new pins apply on reconfigure.
    if(DEFINED K230_BSP_URL)
        set(url "${K230_BSP_URL}")
    endif()
    if(DEFINED K230_BSP_SHA256)
        set(digest "${K230_BSP_SHA256}")
    endif()
    if(NOT DEFINED K230_BSP_CACHE_DIR)
        set(K230_BSP_CACHE_DIR "${CMAKE_SOURCE_DIR}/.cache/k230-bsp")
    endif()
    get_filename_component(cache "${K230_BSP_CACHE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    set(K230_BSP_CACHE_DIR "${cache}" CACHE PATH "K230 Debian BSP release cache" FORCE)
    set(managed "${cache}/${version}/sysroot")
    set(selected "${LILYGO_UI_DEBIAN_SYSROOT}")
    if(selected STREQUAL "" OR selected STREQUAL _K230_BSP_LAST_MANAGED)
        set(selected "$ENV{LILYGO_UI_DEBIAN_SYSROOT}")
    endif()
    if(selected STREQUAL "")
        set(selected "${managed}")
    endif()
    get_filename_component(selected "${selected}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
    if(selected STREQUAL managed)
        _k230_bsp_install("${cache}/${version}" "${asset}" "${url}" "${digest}")
        set(_K230_BSP_LAST_MANAGED "${managed}" CACHE INTERNAL "Automatically selected BSP")
    else()
        unset(_K230_BSP_LAST_MANAGED CACHE)
    endif()
    set(LILYGO_UI_DEBIAN_SYSROOT "${selected}" CACHE PATH "Debian riscv64 development sysroot" FORCE)
endfunction()

_k230_bsp_select()
set(_LILYGO_K230_BSP_SELECTED TRUE)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES K230_BSP_CACHE_DIR K230_BSP_URL
    K230_BSP_SHA256 LILYGO_UI_DEBIAN_SYSROOT)
