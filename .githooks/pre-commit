#!/usr/bin/env bash

set -euo pipefail

formatter="${CLANG_FORMAT:-clang-format}"

if ! command -v "${formatter}" >/dev/null 2>&1; then
  echo "pre-commit: clang-format is required to format C/C++ files." >&2
  exit 1
fi

files=()
while IFS= read -r -d '' file; do
  files+=("${file}")
done < <(
  git diff --cached --name-only --diff-filter=ACMR -z -- \
    '*.c' '*.cc' '*.cpp' '*.cxx' '*.h' '*.hh' '*.hpp' '*.hxx' \
    ':(exclude)third_party/**'
)

if ((${#files[@]} == 0)); then
  exit 0
fi

unstaged=()
for file in "${files[@]}"; do
  if ! git diff --quiet -- "${file}"; then
    unstaged+=("${file}")
  fi
done

if ((${#unstaged[@]} != 0)); then
  echo "pre-commit: cannot safely format partially staged files:" >&2
  printf '  %s\n' "${unstaged[@]}" >&2
  echo "Stage or stash their remaining changes, then commit again." >&2
  exit 1
fi

"${formatter}" -i -- "${files[@]}"
git add -- "${files[@]}"

printf 'pre-commit: formatted %d C/C++ file(s) with clang-format.\n' \
  "${#files[@]}"
